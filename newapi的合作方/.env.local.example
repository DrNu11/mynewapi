# =================================================
# toplenged-ai 环境变量(本地开发 + 207 部署都用这套)
# 复制到 .env.local,填好后 next dev / next start 会自动加载
# =================================================

# --- NewAPI 后端 ---
# BFF 代理 /api/* 转发到这里
NEWAPI_UPSTREAM=https://api.toplenged.com

# Root/Admin 用户在 NewAPI 个人设置里点 "生成系统访问令牌" 得到的字符串
# 用于 PayPal 上账时调 /api/user/manage(action=add_quota)
# ⚠️ 极敏感 — 等同 root 权限,泄漏 = 任何人可改任何用户 quota
NEWAPI_ADMIN_ACCESS_TOKEN=

# --- PayPal Checkout ---
# developer.paypal.com → My Apps & Credentials → Sandbox(测试) / Live(正式)
# 创建 REST API App,拿 Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Client-side(前端 SDK 加载用)— Next.js 默认只读 NEXT_PUBLIC_* 进客户端 bundle
# 写跟 PAYPAL_CLIENT_ID 同一个值即可
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# --- 本地开发端口 ---
# pm2 上 207 时由 ecosystem.config.js 覆盖为 1555
PORT=3200
