# ===== nassaapi-frontend 环境变量 =====
# 把这个文件复制为 .env.local 并填入真实值
# .env.local 已在 .gitignore 里，不会被 commit

# ----- 后台管理员登录 -----
# 访问 /admin/* 时显示登录页（cookie 会话，登录一次默认 30 天有效）
# 兼容：/api/admin/* 也接受 HTTP Basic Auth（方便 curl 调试）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成一个强密码

# Cookie 签名密钥（>=16 字符）。不设则自动从 ADMIN_PASSWORD 派生。
# 显式设置的好处：改密码不会立刻让所有人下线；想强制踢人只需换这个值。
# 推荐生成：openssl rand -hex 32
ADMIN_SESSION_SECRET=

# 登录后 cookie 多少天过期，默认 30
ADMIN_SESSION_DAYS=30

# 额外管理员账号（代理商、合伙人等），JSON 数组
# 主账号还是 ADMIN_USERNAME / ADMIN_PASSWORD，下面这个是"再加一些人"
# 单引号包整体，里面用双引号
# 例：
#   ADMIN_USERS_EXTRA='[{"username":"admin2","password":"deepseek2"}]'
#   ADMIN_USERS_EXTRA='[{"username":"admin2","password":"deepseek2"},{"username":"agent3","password":"xxx"}]'
ADMIN_USERS_EXTRA=

# ----- New API 后端配置 -----
# 你的 New API 部署地址（不带末尾斜杠）
NEWAPI_BASE_URL=https://api.nassaapi.xyz

# 管理员的 access_token
# 获取方法：
#   1. 登录 https://api.nassaapi.xyz 管理员账号（Nassa11111）
#   2. 进入「个人设置」/「Personal Settings」
#   3. 找到「系统访问令牌」/「Generate Access Token」
#   4. 点生成，复制出来粘到这里
NEWAPI_ADMIN_TOKEN=

# 管理员的用户 ID（数字）
# 获取方法：
#   1. 登录管理员后台
#   2. 进入「用户管理」找到自己的行
#   3. 看 ID 列（通常 admin 是 1）
NEWAPI_ADMIN_USER_ID=1

# 1 USD = 多少 quota 額度（与 New API 后台「设置 → 倍率管理 → 数据看板」里 QuotaPerUnit 一致）
# 默认 500000，即 1 美元 = 500000 額度（也就是 1 額度 = 0.000002 美元）
NEWAPI_QUOTA_PER_UNIT=500000

# ----- SQLite 数据存储位置（可选）-----
# 默认存到 ./data/redemptions.db
# 部署到 PM2 / Docker 时建议改成绝对路径，或用 volume 持久化
# NASSAAPI_DATA_DIR=/var/lib/nassaapi/data

# ----- 机器人自动发货共享密钥（用于 /api/bot/redeem）-----
# 闲鱼自动回复机器人等下游机器人调用发货接口时带这个 header：
#   X-Bot-Secret: <BOT_SHARED_SECRET>
# 随便写一串长的随机字符串。建议用 `openssl rand -hex 32` 生成
BOT_SHARED_SECRET=

# （可选）发给买家的消息模板。支持占位符：
#   ${SHORT_URL}, ${AMOUNT_USD}, ${BRAND}, ${EMAIL}, ${CONSOLE_HOST}
# 不设置就用默认文案
# BOT_DELIVERY_TEMPLATE=
