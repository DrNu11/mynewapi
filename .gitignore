# =================================================
# 系统垃圾
# =================================================
.DS_Store
Thumbs.db
*.swp
*~

# =================================================
# 依赖 (能 npm/go install 重装, 不进 git)
# =================================================
node_modules/
**/node_modules/
vendor/
**/vendor/

# =================================================
# 构建产物
# =================================================
.next/
**/.next/
dist/
**/dist/
build/
**/build/
out/
**/out/
*.tsbuildinfo

# Go 构建产物
build-workspace/new-api/one-api
build-workspace/new-api/new-api
build-workspace/new-api/*.exe
build-workspace/new-api/data/
new-api-fork/one-api
new-api-fork/new-api
new-api-fork/data/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# =================================================
# Tier 1: 环境变量 (绝对屏蔽, 含 token / 密码)
# =================================================
.env
.env.local
.env.production
.env.development
.env.*.local
# 但保留模板, 让别人 (或未来的你) 知道格式
!.env.example
!.env.local.example
!.env.*.example

# =================================================
# Tier 1: 数据库 (含客户/业务数据)
# =================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal

# =================================================
# Tier 1: 私钥/证书/加密 key
# =================================================
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.secret_encryption.key
**/.secret*

# =================================================
# 日志 (可能含敏感请求数据)
# =================================================
*.log
logs/
**/logs/

# =================================================
# 临时备份 (我之前部署时留下的 .bak-*)
# =================================================
*.bak
.bak-*/
**/.bak-*/

# =================================================
# IDE / 编辑器
# =================================================
.idea/
.vscode/
.windsurf/
.cursor/

# =================================================
# 大型备份目录 (单独保管, 不进 git)
# =================================================
backups/

# =================================================
# 项目特定 - 含真 sk-key 的配置/数据目录
# =================================================
# openclaw-admin/data 含 nassaapi 真 sk-key (apiKey 字段)
openclaw-admin/data/

# 任何 *.bak.* 类型的备份文件 (旧 sample 配置等)
*.bak.*
**/*.bak.*

# =================================================
# 项目特定: /tmp 类临时脚本不算在内 (在 /tmp 不在仓库)
# =================================================
