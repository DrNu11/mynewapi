# ====== upgrade-api 运行配置 ======
# 复制到 /opt/upgrade-api/.env 后按需修改。
# systemd 会通过 EnvironmentFile= 加载。

# --- 服务自身 ---
UPGRADE_API_HOST=127.0.0.1
UPGRADE_API_PORT=7889

# --- 鉴权（必须改成强随机串！） ---
# 生成示例：openssl rand -hex 32
UPGRADE_API_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- 路径 ---
UPGRADE_API_DATA_DIR=/opt/upgrade-api/data
UPGRADE_API_STATIC_DIR=/opt/upgrade-api/static

# --- OTA 目标（chatgpt2cpa） ---
UPGRADE_TARGET_REPO=/opt/chatgpt2cpa
UPGRADE_TARGET_SERVICE=chatgpt2cpa.service
UPGRADE_TARGET_HEALTH_URL=http://127.0.0.1:7888/
UPGRADE_TARGET_VENV_PIP=/opt/chatgpt2cpa/.venv/bin/pip

# --- OTA 行为 ---
UPGRADE_BACKUP_DIR=/opt/chatgpt2cpa-backups
UPGRADE_UPLOAD_DIR=/opt/upgrade-api/data/uploads
UPGRADE_HEALTH_RETRIES=20
UPGRADE_HEALTH_INTERVAL=1.5
UPGRADE_MAX_UPLOAD_MB=200
