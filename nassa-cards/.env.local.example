# ===== NewAPI 后端对接(必填) =====
# NewAPI 公网根域名(用于调管理 API)
NEWAPI_BASE_URL=https://api.nassaapi.xyz

# 在 NewAPI 后台 - 个人设置 - "系统访问令牌" 生成
NEWAPI_ACCESS_TOKEN=

# 上一步对应账号的用户 ID(NewAPI 后台 - 个人设置 顶部能看到)
NEWAPI_USER_ID=1

# 可选但推荐:用于把卡密 token 迁移到客户 NewAPI 用户名下,让客户看到自己的 NewAPI 使用日志
# 支持 mysql://... 或 Go MySQL DSN,如 root:pass@tcp(172.18.0.2:3306)/new-api?charset=utf8mb4&parseTime=True&loc=Local
NEWAPI_SQL_DSN=

# 给客户展示的 OpenAI 兼容 base URL
PUBLIC_API_BASE=https://api.nassaapi.xyz/v1

# ===== 模型范围(用逗号分隔,会写到 NewAPI token 的 model_limits) =====
ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# ===== 管理员后台(必填) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
SESSION_SECRET=change-this-to-a-32-char-random-string

# ===== 站点品牌(可选) =====
BRAND_NAME=NassaAPI

# ===== Cookie 安全(可选) =====
# 默认 false:允许 HTTP 访问;设为 true 后只有 HTTPS 能用 cookie
# Cloudflare 接入完成后,改为 true 增强安全
COOKIE_SECURE=false

# ===== MiniMax 视频生成(可选,启用 /video 图生视频工作台) =====
# 在 MiniMax 控制台创建 API Key 后填写;只在服务端使用,不要暴露到浏览器
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
